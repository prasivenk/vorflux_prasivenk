<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00051.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR_MemAcc</SHORT-NAME>
      <AR-PACKAGES>

        <!-- ============================================================ -->
        <!-- ECUC MODULE DEFINITION                                        -->
        <!-- ============================================================ -->
        <AR-PACKAGE>
          <SHORT-NAME>EcucModuleDefs</SHORT-NAME>
          <ELEMENTS>
            <ECUC-MODULE-DEF>
              <SHORT-NAME>MemAcc</SHORT-NAME>
              <DESC>
                <L-2 L="EN">AUTOSAR R24-11 Memory Access (MemAcc) Module Configuration</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>

              <CONTAINERS>
                <!-- MemAccGeneral -->
                <ECUC-PARAM-CONF-CONTAINER-DEF>
                  <SHORT-NAME>MemAccGeneral</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">General configuration parameters for the MemAcc module</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF>
                      <SHORT-NAME>MemAccDevErrorDetect</SHORT-NAME>
                      <DESC><L-2 L="EN">Enable/disable development error detection</L-2></DESC>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF>
                      <SHORT-NAME>MemAccVersionInfoApi</SHORT-NAME>
                      <DESC><L-2 L="EN">Enable/disable MemAcc_GetVersionInfo API</L-2></DESC>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>MemAccNumberOfAddressAreas</SHORT-NAME>
                      <DESC><L-2 L="EN">Number of configured address areas</L-2></DESC>
                      <DEFAULT-VALUE>2</DEFAULT-VALUE>
                      <MIN>1</MIN>
                      <MAX>16</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>MemAccMainFunctionPeriod</SHORT-NAME>
                      <DESC><L-2 L="EN">MainFunction call period in ms</L-2></DESC>
                      <DEFAULT-VALUE>5</DEFAULT-VALUE>
                      <MIN>1</MIN>
                      <MAX>100</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>

                <!-- MemAccAddressAreaConfiguration -->
                <ECUC-PARAM-CONF-CONTAINER-DEF>
                  <SHORT-NAME>MemAccAddressAreaConfiguration</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Per-address-area configuration</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>*</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>MemAccAreaId</SHORT-NAME>
                      <DESC><L-2 L="EN">Unique address area identifier (0-based)</L-2></DESC>
                      <MIN>0</MIN>
                      <MAX>15</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>MemAccStartAddress</SHORT-NAME>
                      <DESC><L-2 L="EN">Physical start address of the address area</L-2></DESC>
                      <MIN>0</MIN>
                      <MAX>4294967295</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>MemAccLength</SHORT-NAME>
                      <DESC><L-2 L="EN">Length of the address area in bytes</L-2></DESC>
                      <MIN>1</MIN>
                      <MAX>4294967295</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>MemAccSectorSize</SHORT-NAME>
                      <DESC><L-2 L="EN">Erase sector size in bytes</L-2></DESC>
                      <MIN>256</MIN>
                      <MAX>65536</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>MemAccPageSize</SHORT-NAME>
                      <DESC><L-2 L="EN">Minimum write page size in bytes</L-2></DESC>
                      <MIN>1</MIN>
                      <MAX>256</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>

                <!-- MemAccPublishedInformation -->
                <ECUC-PARAM-CONF-CONTAINER-DEF>
                  <SHORT-NAME>MemAccPublishedInformation</SHORT-NAME>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>MemAccCompareBufferSize</SHORT-NAME>
                      <DESC><L-2 L="EN">Internal buffer size for compare operations (bytes)</L-2></DESC>
                      <DEFAULT-VALUE>32</DEFAULT-VALUE>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>

              </CONTAINERS>
            </ECUC-MODULE-DEF>
          </ELEMENTS>
        </AR-PACKAGE>

      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
