<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00051.xsd">
  <AR-PACKAGES>

    <!-- ================================================================== -->
    <!-- Default Configuration Values for TC3xx (TC39x DF0)                  -->
    <!-- <PLACEHOLDER_REQUIRED> Verify DFLASH base addresses against MCU     -->
    <!-- datasheet for the target TC3xx variant.                             -->
    <!-- ================================================================== -->

    <!-- ================================================================== -->
    <!-- Fee Module Default Configuration                                    -->
    <!-- ================================================================== -->
    <AR-PACKAGE>
      <SHORT-NAME>Fee_DefaultConfig</SHORT-NAME>
      <ELEMENTS>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>Fee</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-MODULE-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee</DEFINITION-REF>
          <CONTAINERS>

            <!-- FeeGeneral -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>FeeGeneral</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeeDevErrorDetect</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeeVersionInfoApi</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeePollingMode</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeeSafetyEnable</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeeReadBackVerification</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeeVirtualPageSize</DEFINITION-REF>
                  <VALUE>32</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeeMainFunctionPeriod</DEFINITION-REF>
                  <VALUE>5</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeeNumberOfSectors</DEFINITION-REF>
                  <VALUE>4</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeeSectorSize</DEFINITION-REF>
                  <VALUE>16384</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeeMaxBlockSize</DEFINITION-REF>
                  <VALUE>512</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeGeneral/FeeGcRestartThreshold</DEFINITION-REF>
                  <VALUE>80</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- FeeBlockConfiguration: Block 1 (32 bytes, normal) -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>FeeBlock_1</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockNumber</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockSize</DEFINITION-REF>
                  <VALUE>32</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeImmediateData</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeNumberOfWriteCycles</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- FeeBlockConfiguration: Block 2 (64 bytes, normal) -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>FeeBlock_2</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockNumber</DEFINITION-REF>
                  <VALUE>2</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockSize</DEFINITION-REF>
                  <VALUE>64</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeImmediateData</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeNumberOfWriteCycles</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- FeeBlockConfiguration: Block 3 (128 bytes, normal) -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>FeeBlock_3</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockNumber</DEFINITION-REF>
                  <VALUE>3</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockSize</DEFINITION-REF>
                  <VALUE>128</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeImmediateData</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeNumberOfWriteCycles</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- FeeBlockConfiguration: Block 4 (256 bytes, normal) -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>FeeBlock_4</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockNumber</DEFINITION-REF>
                  <VALUE>4</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockSize</DEFINITION-REF>
                  <VALUE>256</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeImmediateData</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeNumberOfWriteCycles</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- FeeBlockConfiguration: Block 5 (16 bytes, immediate) -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>FeeBlock_5</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockNumber</DEFINITION-REF>
                  <VALUE>5</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockSize</DEFINITION-REF>
                  <VALUE>16</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeImmediateData</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeNumberOfWriteCycles</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- FeeBlockConfiguration: Block 6 (8 bytes, immediate) -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>FeeBlock_6</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockNumber</DEFINITION-REF>
                  <VALUE>6</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockSize</DEFINITION-REF>
                  <VALUE>8</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeImmediateData</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeNumberOfWriteCycles</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- FeeBlockConfiguration: Block 7 (512 bytes, normal) -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>FeeBlock_7</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockNumber</DEFINITION-REF>
                  <VALUE>7</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockSize</DEFINITION-REF>
                  <VALUE>512</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeImmediateData</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeNumberOfWriteCycles</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- FeeBlockConfiguration: Block 8 (64 bytes, normal) -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>FeeBlock_8</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockNumber</DEFINITION-REF>
                  <VALUE>8</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeBlockSize</DEFINITION-REF>
                  <VALUE>64</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeImmediateData</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeeBlockConfiguration/FeeNumberOfWriteCycles</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- FeePublishedInformation -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>FeePublishedInformation</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeePublishedInformation</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_Fee/EcucModuleDefs/Fee/FeePublishedInformation/FeeBlockOverhead</DEFINITION-REF>
                  <VALUE>32</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
      </ELEMENTS>
    </AR-PACKAGE>

    <!-- ================================================================== -->
    <!-- MemAcc Module Default Configuration                                 -->
    <!-- ================================================================== -->
    <AR-PACKAGE>
      <SHORT-NAME>MemAcc_DefaultConfig</SHORT-NAME>
      <ELEMENTS>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>MemAcc</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-MODULE-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc</DEFINITION-REF>
          <CONTAINERS>

            <!-- MemAccGeneral -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>MemAccGeneral</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccGeneral</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccGeneral/MemAccDevErrorDetect</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccGeneral/MemAccVersionInfoApi</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccGeneral/MemAccNumberOfAddressAreas</DEFINITION-REF>
                  <VALUE>2</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccGeneral/MemAccMainFunctionPeriod</DEFINITION-REF>
                  <VALUE>5</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- Area 0: Fee DFLASH (64KB, 0xAF000000) -->
            <!-- <PLACEHOLDER_REQUIRED> Verify base address against MCU datasheet -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>MemAccArea_0_Fee</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration/MemAccAreaId</DEFINITION-REF>
                  <VALUE>0</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration/MemAccStartAddress</DEFINITION-REF>
                  <VALUE>2936012800</VALUE>  <!-- 0xAF000000 -->
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration/MemAccLength</DEFINITION-REF>
                  <VALUE>65536</VALUE>  <!-- 64KB -->
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration/MemAccSectorSize</DEFINITION-REF>
                  <VALUE>4096</VALUE>  <!-- 4KB sectors -->
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration/MemAccPageSize</DEFINITION-REF>
                  <VALUE>32</VALUE>  <!-- 32-byte pages -->
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- Area 1: Bootloader DFLASH (16KB, 0xAF010000) -->
            <!-- <PLACEHOLDER_REQUIRED> Verify base address against MCU datasheet -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>MemAccArea_1_Bootloader</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration/MemAccAreaId</DEFINITION-REF>
                  <VALUE>1</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration/MemAccStartAddress</DEFINITION-REF>
                  <VALUE>2936078336</VALUE>  <!-- 0xAF010000 -->
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration/MemAccLength</DEFINITION-REF>
                  <VALUE>16384</VALUE>  <!-- 16KB -->
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration/MemAccSectorSize</DEFINITION-REF>
                  <VALUE>4096</VALUE>  <!-- 4KB sectors -->
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccAddressAreaConfiguration/MemAccPageSize</DEFINITION-REF>
                  <VALUE>32</VALUE>  <!-- 32-byte pages -->
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

            <!-- MemAccPublishedInformation -->
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>MemAccPublishedInformation</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccPublishedInformation</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/AUTOSAR_MemAcc/EcucModuleDefs/MemAcc/MemAccPublishedInformation/MemAccCompareBufferSize</DEFINITION-REF>
                  <VALUE>32</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>

          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
      </ELEMENTS>
    </AR-PACKAGE>

  </AR-PACKAGES>
</AUTOSAR>
