<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00051.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR_Fee</SHORT-NAME>
      <AR-PACKAGES>

        <!-- ============================================================ -->
        <!-- ECUC MODULE DEFINITION                                        -->
        <!-- ============================================================ -->
        <AR-PACKAGE>
          <SHORT-NAME>EcucModuleDefs</SHORT-NAME>
          <ELEMENTS>
            <ECUC-MODULE-DEF>
              <SHORT-NAME>Fee</SHORT-NAME>
              <DESC>
                <L-2 L="EN">AUTOSAR R24-11 Flash EEPROM Emulation (Fee) Module Configuration</L-2>
              </DESC>
              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <POST-BUILD-VARIANT-SUPPORT>true</POST-BUILD-VARIANT-SUPPORT>

              <CONTAINERS>
                <!-- FeeGeneral -->
                <ECUC-PARAM-CONF-CONTAINER-DEF>
                  <SHORT-NAME>FeeGeneral</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">General configuration parameters for the Fee module</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-BOOLEAN-PARAM-DEF>
                      <SHORT-NAME>FeeDevErrorDetect</SHORT-NAME>
                      <DESC><L-2 L="EN">Enable/disable development error detection</L-2></DESC>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF>
                      <SHORT-NAME>FeeVersionInfoApi</SHORT-NAME>
                      <DESC><L-2 L="EN">Enable/disable Fee_GetVersionInfo API</L-2></DESC>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF>
                      <SHORT-NAME>FeePollingMode</SHORT-NAME>
                      <DESC><L-2 L="EN">Enable/disable polling mode</L-2></DESC>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF>
                      <SHORT-NAME>FeeSafetyEnable</SHORT-NAME>
                      <DESC><L-2 L="EN">Enable/disable safety checks (RAM CRC)</L-2></DESC>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF>
                      <SHORT-NAME>FeeReadBackVerification</SHORT-NAME>
                      <DESC><L-2 L="EN">Enable/disable write read-back verification</L-2></DESC>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>FeeVirtualPageSize</SHORT-NAME>
                      <DESC><L-2 L="EN">Virtual page size in bytes (TC3xx: 32)</L-2></DESC>
                      <DEFAULT-VALUE>32</DEFAULT-VALUE>
                      <MIN>8</MIN>
                      <MAX>256</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>FeeMainFunctionPeriod</SHORT-NAME>
                      <DESC><L-2 L="EN">MainFunction call period in ms</L-2></DESC>
                      <DEFAULT-VALUE>5</DEFAULT-VALUE>
                      <MIN>1</MIN>
                      <MAX>100</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>FeeNumberOfSectors</SHORT-NAME>
                      <DESC><L-2 L="EN">Number of configured sectors</L-2></DESC>
                      <DEFAULT-VALUE>4</DEFAULT-VALUE>
                      <MIN>2</MIN>
                      <MAX>16</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>FeeSectorSize</SHORT-NAME>
                      <DESC><L-2 L="EN">Sector size in bytes</L-2></DESC>
                      <DEFAULT-VALUE>16384</DEFAULT-VALUE>
                      <MIN>4096</MIN>
                      <MAX>65536</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>FeeMaxBlockSize</SHORT-NAME>
                      <DESC><L-2 L="EN">Maximum block data size in bytes</L-2></DESC>
                      <DEFAULT-VALUE>512</DEFAULT-VALUE>
                      <MIN>1</MIN>
                      <MAX>4096</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>FeeGcRestartThreshold</SHORT-NAME>
                      <DESC><L-2 L="EN">GC restart fill threshold percentage</L-2></DESC>
                      <DEFAULT-VALUE>80</DEFAULT-VALUE>
                      <MIN>50</MIN>
                      <MAX>95</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>

                <!-- FeeBlockConfiguration -->
                <ECUC-PARAM-CONF-CONTAINER-DEF>
                  <SHORT-NAME>FeeBlockConfiguration</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Per-block configuration</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>*</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>FeeBlockNumber</SHORT-NAME>
                      <DESC><L-2 L="EN">Unique block number (1-65534)</L-2></DESC>
                      <MIN>1</MIN>
                      <MAX>65534</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>FeeBlockSize</SHORT-NAME>
                      <DESC><L-2 L="EN">Block data size in bytes</L-2></DESC>
                      <MIN>1</MIN>
                      <MAX>4096</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF>
                      <SHORT-NAME>FeeImmediateData</SHORT-NAME>
                      <DESC><L-2 L="EN">TRUE if this is an immediate-data block</L-2></DESC>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                    </ECUC-BOOLEAN-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>FeeNumberOfWriteCycles</SHORT-NAME>
                      <DESC><L-2 L="EN">Max write cycles (0 = unlimited)</L-2></DESC>
                      <DEFAULT-VALUE>0</DEFAULT-VALUE>
                      <MIN>0</MIN>
                      <MAX>255</MAX>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>

                <!-- FeePublishedInformation -->
                <ECUC-PARAM-CONF-CONTAINER-DEF>
                  <SHORT-NAME>FeePublishedInformation</SHORT-NAME>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <PARAMETERS>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>FeeBlockOverhead</SHORT-NAME>
                      <DESC><L-2 L="EN">Per-block overhead in bytes (header size)</L-2></DESC>
                      <DEFAULT-VALUE>32</DEFAULT-VALUE>
                    </ECUC-INTEGER-PARAM-DEF>
                  </PARAMETERS>
                </ECUC-PARAM-CONF-CONTAINER-DEF>

              </CONTAINERS>
            </ECUC-MODULE-DEF>
          </ELEMENTS>
        </AR-PACKAGE>

      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
